<Project>
  <PropertyGroup>
    <Authors>Joshua Searles,Scott Mitchell,Atif Aziz,others</Authors>
    <NeutralLanguage>en-001</NeutralLanguage>
    <RepositoryUrl>https://github.com/cellcom/celmah</RepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Copyright>Copyright (C) Elmah Contributors. All rights reserved.</Copyright>

    <PackageId>$(MSBuildProjectName)</PackageId>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <Product>$(MSBuildProjectName)</Product>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/cellcom/celmah</PackageProjectUrl>

    <GenerateRepositoryUrlAttribute>true</GenerateRepositoryUrlAttribute>
    <RepositoryType>git</RepositoryType>

    <RollForward>LatestMinor</RollForward>

    <!--
      Versioning:
        VersionPrefix = base version (major.minor.patch)
        VersionSuffix = appended with '-' for prerelease, e.g. "alpha.42" → "1.0.0-alpha.42"
        Leave VersionSuffix empty for stable releases.
        Build scripts auto-set VersionSuffix to "dev.{timestamp}" for local feeds.
    -->
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">alpha.1</VersionSuffix>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <UseArtifactsOutput>true</UseArtifactsOutput>
  </PropertyGroup>

  <ItemGroup>
    <None Condition="Exists('README.md')" Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <Deterministic>true</Deterministic>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
</Project>
